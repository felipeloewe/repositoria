// Repositoria — Fase 1 data model
// Tenant = Empresa. Identity and ACL use stable IDs (cuid); email/RUT are attributes.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Rol {
  ADMINISTRADOR_MASTER
  JEFE_SUCURSAL
  CONTADOR
  ABOGADO
  PREVENCIONISTA
}

/// Organización cliente (tenant). Primary key is `id` (cuid).
model Empresa {
  id        String   @id @default(cuid())
  nombre    String
  slug      String   @unique
  /// Tax ID (RUT/etc.) — complementary attribute, not the ACL key.
  rut       String?
  activa    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sucursales           Sucursal[]
  departamentos        Departamento[]
  membresias           Membresia[]
  expedientes          ExpedienteStub[]
  autorizaciones       ExpedienteAutorizacion[]
  documentoSecciones   DocumentoSeccion[]
  documentos           Documento[]
  documentoAuths       DocumentoAutorizacion[]

  @@index([rut])
  @@map("empresas")
}

/// Sucursal within an Empresa. Scoped by empresaId.
model Sucursal {
  id        String   @id @default(cuid())
  empresaId String
  nombre    String
  codigo    String?
  activa    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  empresa            Empresa            @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  departamentos      Departamento[]
  membresias         Membresia[]
  expedientes        ExpedienteStub[]
  documentoSecciones DocumentoSeccion[]
  documentos         Documento[]

  @@unique([empresaId, nombre])
  @@index([empresaId])
  @@map("sucursales")
}

/// Departamento under a Sucursal.
model Departamento {
  id         String   @id @default(cuid())
  empresaId  String
  sucursalId String
  nombre     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  empresa  Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  sucursal Sucursal @relation(fields: [sucursalId], references: [id], onDelete: Cascade)

  @@unique([sucursalId, nombre])
  @@index([empresaId])
  @@index([sucursalId])
  @@map("departamentos")
}

/// Global user identity. Primary key is `id` (cuid). Email/RUT are attributes.
model Usuario {
  id           String   @id @default(cuid())
  email        String   @unique
  nombre       String
  /// Tax ID (RUT/etc.) — complementary attribute, not the ACL key.
  rut          String?
  /// Local auth hash; replace with IdP later.
  passwordHash String?
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  membresias         Membresia[]
  autorizaciones     ExpedienteAutorizacion[]
  documentosSubidos  Documento[]              @relation("DocumentoSubidoPor")
  documentoAuths     DocumentoAutorizacion[]

  @@index([rut])
  @@map("usuarios")
}

/// One membership per (usuarioId, empresaId) → rol + optional sucursal scope.
model Membresia {
  id         String   @id @default(cuid())
  empresaId  String
  usuarioId  String
  rol        Rol
  /// Required for JEFE_SUCURSAL; optional for external roles when scoped to a branch.
  sucursalId String?
  activa     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  empresa  Empresa   @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  usuario  Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  sucursal Sucursal? @relation(fields: [sucursalId], references: [id], onDelete: SetNull)

  @@unique([usuarioId, empresaId])
  @@index([empresaId])
  @@index([usuarioId])
  @@index([sucursalId])
  @@map("membresias")
}

/// Minimal expediente stub for Fase 1 ACL demos (not full document storage).
model ExpedienteStub {
  id         String   @id @default(cuid())
  empresaId  String
  sucursalId String?
  titulo     String
  tipo       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  empresa        Empresa                  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  sucursal       Sucursal?                @relation(fields: [sucursalId], references: [id], onDelete: SetNull)
  autorizaciones ExpedienteAutorizacion[]

  @@index([empresaId])
  @@index([sucursalId])
  @@map("expedientes_stub")
}

/// Grants a user (by usuarioId) access to a specific expediente stub.
model ExpedienteAutorizacion {
  id           String   @id @default(cuid())
  empresaId    String
  expedienteId String
  usuarioId    String
  createdAt    DateTime @default(now())

  empresa    Empresa        @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  expediente ExpedienteStub @relation(fields: [expedienteId], references: [id], onDelete: Cascade)
  usuario    Usuario        @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([expedienteId, usuarioId])
  @@index([empresaId])
  @@index([usuarioId])
  @@map("expediente_autorizaciones")
}

/// Sección/carpeta del repositorio: corporativa (sucursalId null) o por sucursal.
model DocumentoSeccion {
  id         String   @id @default(cuid())
  empresaId  String
  /// null = sección corporativa de la empresa
  sucursalId String?
  nombre     String
  /// Ej. CONTRATOS, LIQUIDACIONES, GENERAL
  codigo     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  empresa    Empresa     @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  sucursal   Sucursal?   @relation(fields: [sucursalId], references: [id], onDelete: Cascade)
  documentos Documento[]

  @@unique([empresaId, sucursalId, codigo])
  @@index([empresaId])
  @@index([sucursalId])
  @@map("documento_secciones")
}

/// Documento del repositorio unificado por empresa (Fase 2).
model Documento {
  id            String   @id @default(cuid())
  empresaId     String
  seccionId     String
  /// Denormalizado desde la sección para consultas ACL (null = corporativo).
  sucursalId    String?
  titulo        String
  nombreArchivo String
  mimeType      String
  tamanioBytes  Int
  /// Ruta relativa bajo STORAGE_ROOT
  storageKey    String
  subidoPorId   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  empresa        Empresa                 @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  seccion        DocumentoSeccion        @relation(fields: [seccionId], references: [id], onDelete: Cascade)
  sucursal       Sucursal?               @relation(fields: [sucursalId], references: [id], onDelete: SetNull)
  subidoPor      Usuario                 @relation("DocumentoSubidoPor", fields: [subidoPorId], references: [id])
  autorizaciones DocumentoAutorizacion[]

  @@index([empresaId])
  @@index([seccionId])
  @@index([sucursalId])
  @@index([subidoPorId])
  @@map("documentos")
}

/// Autorización explícita (externos u otros) a un documento por usuarioId.
model DocumentoAutorizacion {
  id          String   @id @default(cuid())
  empresaId   String
  documentoId String
  usuarioId   String
  createdAt   DateTime @default(now())

  empresa   Empresa   @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  documento Documento @relation(fields: [documentoId], references: [id], onDelete: Cascade)
  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([documentoId, usuarioId])
  @@index([empresaId])
  @@index([usuarioId])
  @@map("documento_autorizaciones")
}
