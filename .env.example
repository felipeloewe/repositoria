# MySQL connection string for Prisma
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://repositoria:repositoria@localhost:3306/repositoria"

# Local disk root for document files (Fase 2). Default: ./storage/documents
# STORAGE_ROOT="/var/repositoria/documents"

# Set to 1 to force logged-out state
# AUTH_STUB_DISABLED=1

# Optional local-only impersonation UI at /dev/switcher (not product entry)
# DEV_AUTH_SWITCHER=1
