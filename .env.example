# MySQL connection string for Prisma
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://repositoria:repositoria@localhost:3306/repositoria"

# Local disk root for document files (Fase 2). Default: ./storage/documents
# STORAGE_ROOT="/var/repositoria/documents"

# --- Fase 3: imap-mail service ---
# Base URL of the parallel mail index (no trailing slash).
# Preferred name; IMAP_MAIL_URL is accepted as an alias.
# When unset, Correo UI uses offline mock fixtures.
# IMAP_MAIL_BASE_URL="http://localhost:3001"
# IMAP_MAIL_URL="http://localhost:3001"

# Optional shared secret for POST /api/webhooks/imap-mail
# (imap-mail sets REPOSITORIA_WEBHOOK_URL → this app)
# REPOSITORIA_WEBHOOK_SECRET=

# Set to 1 to force logged-out state
# AUTH_STUB_DISABLED=1

# Optional local-only impersonation UI at /dev/switcher (not product entry)
# DEV_AUTH_SWITCHER=1
