#--------------------------------------------------------------------
# Repositoria — CodeIgniter 4 + PHP 8.2+/8.5 + MySQL
# Copy to `.env` and fill values. Never commit `.env`.
#--------------------------------------------------------------------

CI_ENVIRONMENT = development

# Public URL of the app (include trailing slash).
# Local:  http://localhost:8080/
# cPanel: https://repositoria.tudominio.cl/
app.baseURL = 'http://localhost:8080/'
# app.forceGlobalSecureRequests = false

#--------------------------------------------------------------------
# DATABASE (MySQL 8.x)
#--------------------------------------------------------------------
database.default.hostname = localhost
database.default.database = repositoria
database.default.username = repositoria
database.default.password = repositoria
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_unicode_ci

#--------------------------------------------------------------------
# ENCRYPTION / SESSION
#--------------------------------------------------------------------
# Generate with: php spark key:generate
# encryption.key =

#--------------------------------------------------------------------
# STORAGE (Fase 2 — documentos en disco)
#--------------------------------------------------------------------
# Absolute path for uploaded blobs. Default: {project}/storage/documents
# STORAGE_ROOT = /home/CUENTA/repositoria/storage/documents

#--------------------------------------------------------------------
# FASE 3 — imap-mail (servicio paralelo)
#--------------------------------------------------------------------
# Base URL sin trailing slash. Si está vacío o el servicio cae → mock offline.
# Local:  http://localhost:3001
# Live:   https://imap.booklet.cl
# IMAP_MAIL_BASE_URL = https://imap.booklet.cl
# IMAP_MAIL_URL = https://imap.booklet.cl
# Secreto compartido con imap-mail para POST /api/webhooks/imap-mail
# (alias IMAP_MAIL_WEBHOOK_SECRET también aceptado)
# REPOSITORIA_WEBHOOK_SECRET =
# IMAP_MAIL_WEBHOOK_SECRET =
